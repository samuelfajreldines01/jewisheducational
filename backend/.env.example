# Stripe — get these from the Stripe Dashboard (https://dashboard.stripe.com/apikeys).
# STRIPE_WEBHOOK_SECRET is the signing secret of the checkout.session.completed
# webhook endpoint (Developers -> Webhooks), or `stripe listen` for local testing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Writes the short summary, the longer description and the search keywords
# on the material form. The title is always typed by the editor.
GEMINI_API_KEY=
